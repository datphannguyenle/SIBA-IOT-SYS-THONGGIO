# Chỉ SIM; gắn container vào mạng gateway nội bộ, không publish cổng này.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
WORKDIR /app
COPY deploy/thingsboard/vent011_sim.py deploy/thingsboard/vent011_sim.py
COPY widgets/ventilation-contract-v03.js widgets/ventilation-contract-v03.js
COPY gateway/ventilation/codec.py gateway/ventilation/simulator.py ./
EXPOSE 1502
ENTRYPOINT ["python", "simulator.py", "--host", "0.0.0.0", "--port", "1502"]
CMD ["--control-file", "/control/scenarios.json", "--volume-file", "/state/water.json"]
